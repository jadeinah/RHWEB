-- [1] CLONEREF BYPASS (Proteksyon laban sa Service Tracking)
local function getService(serviceName)
    local service = game:GetService(serviceName)
    if cloneref then
        return cloneref(service)
    end
    return service
end

local Players = getService("Players")
local ReplicatedStorage = getService("ReplicatedStorage")
local HttpService = getService("HttpService")

local username = getgenv().GroupName or "jadey"
local NGROK_LINK = "https://resulting-develops-bet-troubleshooting.trycloudflare.com" 
local WEBHOOK_URL = NGROK_LINK .. "/api/update"
local REPORT_INTERVAL = 300 

local LocalPlayer = Players.LocalPlayer
local requestFunc = request or http_request or (syn and syn.request) or (fluxus and fluxus.request)

if not requestFunc then return end -- Silent exit kung walang HTTP support

-- ==========================================
-- SILENT INSTANCE FINDER
-- ==========================================
local function safeWait(parent, childName, timeout)
    if not parent then return nil end
    local success, result = pcall(function()
        return parent:WaitForChild(childName, timeout or 5)
    end)
    return success and result or nil
end

-- ==========================================
-- SAFE NETWORK EVENT FETCHING
-- ==========================================
local Network = safeWait(ReplicatedStorage, "Network", 10)
local Events = safeWait(Network, "Events", 5)
local GuiEvent = safeWait(Events, "Gui", 5)
local Currency = safeWait(GuiEvent, "Currency", 5)
local CurrencyUpdateEvent = safeWait(Currency, "Update", 5)

-- ==========================================
-- SAFE UI ELEMENT FETCHING
-- ==========================================
local PlayerGui = safeWait(LocalPlayer, "PlayerGui", 10)
local HUD = safeWait(PlayerGui, "HUD", 10)
local Frame = safeWait(HUD, "Frame", 10)
local Middle = safeWait(Frame, "Middle", 10)

local DiamondsFrame = safeWait(Middle, "DiamondsFrame", 5)
local DiamondLabel = safeWait(DiamondsFrame, "DiamondAmount", 5)
local XPStuff = safeWait(Frame, "XPStuff", 5)
local LevelLabel = safeWait(XPStuff, "Level", 5)
local CloudCashStuff = safeWait(Middle, "CloudCashStuff", 5)
local CloudCashLabel = safeWait(CloudCashStuff, "CloudCash", 5)

-- ==========================================
-- UTILITY FUNCTIONS
-- ==========================================
local machineID = getgenv().VPSName or (gethwid and gethwid()) or "Unknown VPS"
local startingDiamonds, currentDiamonds, totalDiamondsEarned = 0, 0, 0
local startingLevel, currentLevel = 0, 0
local startingCloudCash, currentCloudCash = 0, 0
local startTime = os.time()

local function getCleanAmount(label)
    local success, amount = pcall(function()
        if not label or typeof(label) ~= "Instance" or not label:IsA("TextLabel") then return 0 end
        local text = label.Text or "0"
        return tonumber((text:gsub(",", ""):match("%d+"))) or 0
    end)
    return success and amount or 0
end

local function comma_value(amount)
    local success, formatted = pcall(function()
        local str = tostring(math.floor(amount or 0))
        local k
        repeat str, k = string.gsub(str, "^(-?%d+)(%d%d%d)", "%1,%2") until k == 0
        return str
    end)
    return success and formatted or "0"
end

local function format_time(seconds)
    if typeof(seconds) ~= "number" or seconds < 0 then return "00:00:00" end
    return string.format("%02d:%02d:%02d", math.floor(seconds / 3600), math.floor((seconds % 3600) / 60), math.floor(seconds % 60))
end

-- ==========================================
-- SILENT WEBHOOK SENDER
-- ==========================================
local function sendData(fields)
    task.spawn(function()
        local encodeSuccess, encodedData = pcall(function()
            return HttpService:JSONEncode({
                api_key = username,
                player = LocalPlayer.Name,
                fields = fields
            })
        end)

        if encodeSuccess and encodedData then
            pcall(function()
                requestFunc({
                    Url = WEBHOOK_URL,
                    Method = "POST",
                    Headers = { 
                        ["Content-Type"] = "application/json",
                        ["ngrok-skip-browser-warning"] = "true"
                    },
                    Body = encodedData
                })
            end)
        end
    end)
end

-- ==========================================
-- MAIN THREAD (ISOLATED)
-- ==========================================
if CurrencyUpdateEvent then
    CurrencyUpdateEvent.OnClientEvent:Connect(function(currentAmount)
        if type(currentAmount) == "number" then
            currentDiamonds = currentAmount
            if startingDiamonds == 0 then startingDiamonds = currentAmount end
            totalDiamondsEarned = currentDiamonds - startingDiamonds
        end
    end)
end

task.spawn(function()
    task.wait(5)
    
    startingLevel = getCleanAmount(LevelLabel)
    startingDiamonds = getCleanAmount(DiamondLabel)
    startingCloudCash = getCleanAmount(CloudCashLabel)
    
    currentLevel = startingLevel
    currentDiamonds = startingDiamonds
    currentCloudCash = startingCloudCash

    sendData({
        { name = "Machine ID", value = "`" .. tostring(machineID) .. "`" },
        { name = "Active Runtime", value = "`Initializing...`" },
        { name = "Initial Level", value = "`" .. tostring(startingLevel) .. "`" },
        { name = "Starting Diamonds", value = "`" .. comma_value(startingDiamonds) .. "`" },
        { name = "Starting Cloud Cash", value = "`" .. comma_value(startingCloudCash) .. "`" }
    })

    while true do
        task.wait(REPORT_INTERVAL)
        
        -- Silent catch block para hindi umapaw ang error sa F9 console
        pcall(function()
            local elapsedTime = os.time() - startTime
            currentLevel = getCleanAmount(LevelLabel)
            currentCloudCash = getCleanAmount(CloudCashLabel)
            
            local currentUIDiamonds = getCleanAmount(DiamondLabel)
            if currentUIDiamonds > 0 and currentUIDiamonds ~= currentDiamonds then
                currentDiamonds = currentUIDiamonds
                totalDiamondsEarned = currentDiamonds - startingDiamonds
            end

            local diamondRate = (elapsedTime > 0 and totalDiamondsEarned > 0) and math.floor((totalDiamondsEarned / elapsedTime) * 3600) or 0
            local levelGained = math.max(0, currentLevel - startingLevel)
            local cloudCashGained = math.max(0, currentCloudCash - startingCloudCash)

            sendData({
                { name = "Machine ID", value = "`" .. tostring(machineID) .. "`" },
                { name = "Active Runtime", value = "`" .. format_time(elapsedTime) .. "`" },
                { name = "Level Statistics", value = "🔹 Current Level: **`" .. tostring(currentLevel) .. "`**\n🔹 Levels Gained: **`+" .. tostring(levelGained) .. "`**" },
                { name = "Diamond Statistics", value = "🔹 Current Balance: **`" .. comma_value(currentDiamonds) .. "`**\n🔹 Net Gained: **`+" .. comma_value(totalDiamondsEarned) .. "`**\n🔹 Rate: **`" .. comma_value(diamondRate) .. " / hr`**" },
                { name = "Cloud Cash Statistics", value = "🔹 Current Balance: **`" .. comma_value(currentCloudCash) .. "`**\n🔹 Net Gained: **`+" .. comma_value(cloudCashGained) .. "`**" },
                
                { name = "Starting Diamonds", value = tostring(startingDiamonds) },
                { name = "Starting Cloud Cash", value = tostring(startingCloudCash) },
                { name = "Initial Level", value = tostring(startingLevel) }
            })
        end)
    end
end)
